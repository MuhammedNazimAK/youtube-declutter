{
  "manifest_version": 3,
  "name": "YouTube Thumbnail Desaturator",
  "version": "1.0",
  "description": "Reduce oversaturated colors in Youtube thumbnails.",
  "permissions": ["storage"], 
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "images/icons/icon16.png",
    "48": "images/icons/icon48.png",
    "128": "images/icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icons/icon16.png",
      "48": "images/icons/icon48.png"
    },
    "default_popup": "popup.html"
  }
}
